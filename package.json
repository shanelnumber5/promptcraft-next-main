{
  "name": "promptcraft-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PromptCraft creative instructional-design playground with shared Scenario and Workspace routes",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node tests/run-unit.cjs && node tests/unit/server.test.cjs",
    "test:lab": "node tests/browser/idea-lab.test.cjs",
    "test:design": "node tests/unit/design.test.cjs",
    "test:babbage": "node tests/unit/babbage.test.cjs",
    "test:maya": "node tests/unit/maya.test.cjs",
    "test:server": "node tests/unit/server.test.cjs",
    "test:browser": "node tests/browser/shared-routes.test.cjs",
    "format": "prettier --write index.html package.json README.md docs src server tests",
    "format:check": "prettier --check index.html package.json README.md docs src server tests",
    "test:scenario-studio": "node tests/browser/scenario-studio.test.cjs",
    "test:workspace-layout": "node tests/browser/workspace-layout.test.cjs",
    "test:unit": "node tests/run-unit.cjs"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
